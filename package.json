{
  "name": "baton-ai",
  "version": "0.1.0",
  "description": "Pass your Claude Code or Codex session to the next agent: one file with the whole conversation, your rules, and your unfinished code.",
  "type": "module",
  "bin": {
    "baton": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/setup.ts --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "agent",
    "handoff",
    "handover",
    "context",
    "cli"
  ],
  "author": "Felipe Longé",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felo/baton.git"
  },
  "homepage": "https://github.com/felo/baton#readme",
  "bugs": "https://github.com/felo/baton/issues",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
